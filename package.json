{
  "name": "nearpay-site",
  "version": "0.1.0",
  "private": true,
  "description": "NearPay public static sites from one Astro project: developer docs (dist/docs) and marketing (dist/web).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:docs": "NP_SITE=docs astro dev --port 4322",
    "build": "pnpm build:web && pnpm build:docs && node scripts/check-dist.mjs",
    "build:web": "NP_SITE=web astro build",
    "build:docs": "NP_SITE=docs astro build",
    "typecheck": "astro check && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "shots": "node scripts/screenshots.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build && pnpm e2e"
  },
  "dependencies": {
    "@astrojs/prism": "3.3.0",
    "@nearpay-internal/ui": "0.2.0",
    "@nearpay/spec": "0.2.0",
    "astro": "5.18.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.11.0",
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
