---
/**
 * Marketing page shell, design v2 (Main artboard): sticky header (Convergence logo, nav to the landing sections
 * and Docs, two rectangular buttons, owner 2026-11-11: "Sign in" white with indigo text, "Contact team" solid
 * indigo with a chevron), main, footer. Nav (owner, 2026-11-12): How it works, Products, Developers, Pricing,
 * Docs; section links are in-page anchors on the home page and `/#id` elsewhere (config/site.ts headerNav).
 * Below 1100 px the nav and both buttons move into a native <details> disclosure; scripts/menu.ts only closes
 * it after a section link is chosen or on Escape.
 */
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { headerNav, links } from "../config/site";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Canonical URL when it isn't this page's own (forwarding pages). */
  canonical?: string;
}
const { title, description, noindex, canonical } = Astro.props;
const onHome = Astro.url.pathname.replace(/(index)?(\.html)?$/, "") === "/";
const nav = headerNav(onHome);
const footer = [
  { label: "Pricing", href: onHome ? "#pricing" : "/#pricing" },
  { label: "Docs", href: links.docsHome },
  { label: "Support", href: "/support" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
];
---
<Base title={title} description={description} bodyClass="web" noindex={noindex} canonical={canonical}>
  <slot name="head" slot="head" />
  <header class="web-header">
    <div class="site-container web-header__bar">
      <Logo href="/" />
      <nav class="web-nav web-header__wide" aria-label="Main">
        <ul class="web-nav__list">
          {
            nav.map((item) => (
              <li>
                <a class="web-nav__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="web-header__actions web-header__wide">
        <a class="np-button np-button--secondary" href={links.signin}>Sign in</a>
        <a class="np-button np-button--primary" href="/support">
          Contact team<Icon name="chevron-right" size={16} class="np-button__chevron" />
        </a>
      </div>
      <details class="web-menu web-header__narrow">
        <summary aria-label="Menu">
          <span class="web-menu__open"><Icon name="menu" size={24} /></span>
          <span class="web-menu__close"><Icon name="close" size={24} /></span>
        </summary>
        <nav class="web-menu__panel" aria-label="Main">
          <ul class="web-menu__list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
            <li class="web-menu__cta">
              <a class="np-button np-button--secondary" href={links.signin}>Sign in</a>
              <a class="np-button np-button--primary" href="/support">
                Contact team<Icon name="chevron-right" size={16} class="np-button__chevron" />
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </header>
  <main id="main" class="web-main" tabindex="-1">
    <slot />
  </main>
  <footer class="web-footer">
    <div class="site-container web-footer__inner">
      <p class="web-footer__legal">NearPay. Payments on NEAR Intents.</p>
      <nav aria-label="Footer">
        <ul class="footer-links">
          {footer.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </footer>
  <script src="../scripts/menu.ts"></script>
</Base>
