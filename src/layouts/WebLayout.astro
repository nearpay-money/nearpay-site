---
/**
 * Marketing page shell, design v2 (Main artboard): header (Convergence logo, product nav, Sign in, navy pill
 * "Start accepting payments"), main, footer. Below 1100 px the nav, Sign in and the CTA move into a native
 * <details> disclosure (no script).
 */
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { links, urls } from "../config/site";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  /** Marks the matching nav item as the current page. */
  current?: "payments" | "billing" | "pricing";
  noindex?: boolean;
}
const { title, description, current, noindex } = Astro.props;
const nav = [
  { id: "payments", label: "Checkout", href: "/payments#checkout" },
  { id: "links", label: "Payment links", href: "/payments#links" },
  { id: "billing", label: "Subscriptions", href: "/billing" },
  { id: "agents", label: "Agent payments", href: "/payments#agents" },
  { id: "docs", label: "Docs", href: urls.docs },
];
const footer = [
  { label: "Pricing", href: "/pricing" },
  { label: "Docs", href: links.docsHome },
  { label: "Support", href: "/support" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
];
---
<Base title={title} description={description} bodyClass="web" noindex={noindex}>
  <header class="web-header">
    <div class="site-container web-header__bar">
      <Logo href="/" />
      <nav class="web-nav web-header__wide" aria-label="Main">
        <ul class="web-nav__list">
          {
            nav.map((item) => (
              <li>
                <a class="web-nav__link" href={item.href} aria-current={item.id === current ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="web-header__actions web-header__wide">
        <a class="web-nav__link web-header__signin" href={links.signin}>Sign in</a>
        <a class="np-button np-button--navy np-button--pill web-header__cta" href={links.signup}>Start accepting payments</a>
      </div>
      <details class="web-menu web-header__narrow">
        <summary aria-label="Menu">
          <span class="web-menu__open"><Icon name="menu" size={24} /></span>
          <span class="web-menu__close"><Icon name="close" size={24} /></span>
        </summary>
        <nav class="web-menu__panel" aria-label="Main">
          <ul class="web-menu__list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.id === current ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/pricing" aria-current={current === "pricing" ? "page" : undefined}>Pricing</a></li>
            <li><a href={links.signin}>Sign in</a></li>
            <li class="web-menu__cta">
              <a class="np-button np-button--navy np-button--pill np-button--full" href={links.signup}>Start accepting payments</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </header>
  <main id="main" class="web-main" tabindex="-1">
    <slot />
  </main>
  <footer class="web-footer">
    <div class="site-container web-footer__inner">
      <p class="web-footer__legal">NearPay. Payments on NEAR Intents.</p>
      <nav aria-label="Footer">
        <ul class="footer-links">
          {footer.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </footer>
</Base>
