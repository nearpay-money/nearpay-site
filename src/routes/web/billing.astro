---
/** Billing is not available yet (Stage 3). The page says so plainly and points to what works today. */
import { links } from "../../config/site";
import WebLayout from "../../layouts/WebLayout.astro";
---
<WebLayout
  title="Billing — coming next — NearPay"
  description="Invoices and recurring billing with payment approval in the customer’s wallet are coming next to NearPay."
  current="billing"
>
  <section class="page-hero" aria-labelledby="billing-title">
    <div class="site-container">
      <p class="eyebrow">Billing</p>
      <h1 id="billing-title" class="heading-section">Invoices and recurring billing, approved in the customer’s wallet.</h1>
      <p class="lede">
        Send invoices your customers pay from their own wallet, and bill subscriptions with limits the customer approves
        up front. Billing isn’t available yet — it’s the next thing we’re building.
      </p>
      <span class="np-badge np-badge--warning">Coming next</span>
    </div>
  </section>
  <section class="band band--white" aria-labelledby="billing-plan">
    <div class="site-container">
      <div class="section-head">
        <h2 id="billing-plan" class="heading-section">What’s planned</h2>
      </div>
      <ul class="columns">
        <li>
          <h3 class="column__title">Invoices</h3>
          <p class="column__body">Itemised invoices with a hosted page to pay them. No NearPay account or email needed to pay.</p>
        </li>
        <li>
          <h3 class="column__title">Subscriptions</h3>
          <p class="column__body">Recurring prices with renewal reminders, so customers know what’s coming before they pay.</p>
        </li>
        <li>
          <h3 class="column__title">Customer-approved limits</h3>
          <p class="column__body">Customers approve how much can be collected and how often. Funds still settle directly to you.</p>
        </li>
      </ul>
    </div>
  </section>
  <section class="band cta" aria-labelledby="billing-cta">
    <div class="site-container">
      <h2 id="billing-cta" class="heading-section">Take payments today.</h2>
      <p class="lede">Checkout and payment links are available now.</p>
      <div class="cta__actions hero__actions">
        <a class="np-button np-button--primary-wide" href={links.signup}>Get started</a>
        <a class="np-button np-button--secondary" href="/payments">Explore payments</a>
      </div>
    </div>
  </section>
</WebLayout>
