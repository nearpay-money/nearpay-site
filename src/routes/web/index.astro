---
/**
 * Marketing home — design v2 (owner-approved 2026-11-11) with the landing v3 changes (owner, 2026-11-11):
 * hero with the new headline, Get started / Sign up and a multi-colour aurora behind the ConvergenceHero
 * panel; chain strip; the payment flow as an animated diagram; the product showcase (bento of animated
 * product cards, the developer section folded in); the non-custodial band.
 */
import ConvergencePanel from "../../components/web/ConvergencePanel.astro";
import PaymentFlow from "../../components/web/PaymentFlow.astro";
import Showcase from "../../components/web/showcase/Showcase.astro";
import { links, TAGLINE } from "../../config/site";
import WebLayout from "../../layouts/WebLayout.astro";
import "../../styles/showcase.css";

// Hero copy (owner, 2026-11-11): two-line headline = TAGLINE split at its full stop; one short lede.
const heroLines = TAGLINE.split(/(?<=\.)\s+/);
const HERO_LEDE =
  "Customers pay however they like: any token, any blockchain. You get paid exactly how you like, in your own wallet.";
const chains = ["NEAR", "Ethereum", "Base", "Arbitrum", "Solana", "Bitcoin", "Polygon", "BNB Chain"];
const promises = [
  {
    title: "We never hold your money",
    body: "Funds go straight from your customer to the payout wallet you prove you own.",
  },
  {
    title: "Every payment is checked",
    body: "An independent checker confirms recipient, token and amount on-chain before we call it paid.",
  },
  {
    title: "Live in minutes",
    body: "Sign up, add your business details and a payout wallet, and take real payments the same day.",
  },
];
---
<WebLayout
  title={`NearPay — ${TAGLINE}`}
  description="Customers pay with any token on any blockchain; you get paid in the asset and on the chain you choose, straight to your own wallet. Non-custodial crypto payments on NEAR Intents."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="site-container hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title">
          {heroLines.map((line, i) => <>{i > 0 && " "}<span class="hero__line">{line}</span></>)}
        </h1>
        <p class="hero__lede">{HERO_LEDE}</p>
        <div class="hero__actions">
          <a class="np-button np-button--primary np-button--lg" href={links.docsGetStarted}>Get started</a>
          <a class="np-button np-button--secondary np-button--lg" href={links.signup}>Sign up</a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero-aurora" aria-hidden="true">
          <span class="hero-aurora__layer hero-aurora__layer--a"></span>
          <span class="hero-aurora__layer hero-aurora__layer--b"></span>
        </div>
        <ConvergencePanel />
      </div>
    </div>
  </section>

  <section class="chain-strip" aria-labelledby="chains-title">
    <div class="site-container chain-strip__inner">
      <p id="chains-title" class="chain-strip__title">Accept payments from every major chain. Settle on the one you choose.</p>
      <ul class="chain-strip__list">
        {chains.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <PaymentFlow />

  <Showcase />

  <section class="promise-band" aria-label="Why NearPay">
    <div class="site-container">
      <ul class="promise-band__list">
        {
          promises.map((p) => (
            <li>
              <h3 class="promise-band__title">{p.title}</h3>
              <p class="promise-band__body">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</WebLayout>
