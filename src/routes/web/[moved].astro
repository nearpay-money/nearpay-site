---
/**
 * Forwarding pages for the old marketing URLs (/payments, /billing, /pricing; removed 2026-11-12). The static
 * hosting has no redirect rules in this repo, so each old URL builds as a tiny noindex page that forwards to the
 * matching home section with `<meta http-equiv="refresh">` (allowed under the strict CSP: no directive governs
 * it, and no script runs) and shows a plain link if the browser doesn't follow it. Canonical = the target.
 */
import { HOME_SECTIONS, MOVED_PAGES, urls } from "../../config/site";
import WebLayout from "../../layouts/WebLayout.astro";

export function getStaticPaths() {
  return Object.entries(MOVED_PAGES).map(([moved, page]) => ({ params: { moved }, props: page }));
}
const { to, title } = Astro.props;
const section = HOME_SECTIONS.find((s) => s.id === to);
const target = `/#${to}`;
---
<WebLayout
  title={`${title} has moved | NearPay`}
  description={`${title} is now part of the NearPay home page.`}
  canonical={`${urls.web}${target}`}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0; url=${target}`} />
  <section class="page-hero" aria-labelledby="moved-title">
    <div class="site-container">
      <h1 id="moved-title" class="heading-section">{title} is now on the home page.</h1>
      <p class="lede">You’ll be taken there automatically.</p>
      <div class="page-actions">
        <a class="np-button np-button--primary np-button--lg" href={target}>Go to {section?.label ?? "the home page"}</a>
      </div>
    </div>
  </section>
</WebLayout>
