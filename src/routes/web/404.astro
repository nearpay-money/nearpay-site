---
import WebLayout from "../../layouts/WebLayout.astro";
---
<WebLayout title="Page not found | NearPay" description="This page doesn’t exist." noindex>
  <section class="page-hero" aria-labelledby="nf-title">
    <div class="site-container">
      <p class="eyebrow">404</p>
      <h1 id="nf-title" class="heading-section">We can’t find that page.</h1>
      <p class="lede">It may have moved. Try the home page or the docs.</p>
      <div class="page-actions">
        <a class="np-button np-button--primary np-button--lg" href="/">Go to the home page</a>
      </div>
    </div>
  </section>
</WebLayout>
