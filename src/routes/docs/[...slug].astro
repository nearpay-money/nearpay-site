---
/** Hand-written guides from src/content/docs (Markdown). */
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout title={entry.data.title} description={entry.data.description} eyebrow={entry.data.eyebrow} toc={headings}>
  <div class="prose">
    <Content />
  </div>
</DocsLayout>
