---
/**
 * The invented merchant used across the showcase mockups: "Pebblequest", a fictional web3 game studio
 * (pebblequest.example, a reserved example domain). Mark: a pebble with a star. Not a real brand.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---
<svg class:list={["pq-mark", className]} viewBox="0 0 24 24" width={size} height={size} focusable="false">
  <path d="M12.4 2.6c5.3.3 9.1 4.2 9 9.4-.1 5.4-4.3 9.4-9.8 9.4-5.4 0-9.1-4-9.1-9.2 0-5.6 4.4-9.9 9.9-9.6z" fill="#FFB25B" />
  <path d="M12 6.8l1.5 3.2 3.4.4-2.5 2.3.7 3.4L12 14.4l-3.1 1.7.7-3.4-2.5-2.3 3.4-.4z" fill="#12263F" />
</svg>
