---
import { money, rescale, USD, USDC } from "../../lib/money";
/**
 * The hero's illustrative checkout (Figma marketing frame). Not interactive: a figure with plain text,
 * so nothing here looks focusable or clickable. Amounts are integer base units (INV-5) formatted with
 * the kit's formatter; the payer fee is shown separately from the merchant's settlement.
 */
import Icon from "../Icon.astro";

const price = 4900n; // USD cents — $49.00
const fee = 49n; // USD cents — $0.49 (illustrative; real fees depend on the route, see /pricing)
const payUsdc = rescale(price + fee, USD.decimals, USDC.decimals);
const receiveUsdc = rescale(price, USD.decimals, USDC.decimals);
---
<figure class="np-card demo-card" aria-labelledby="demo-card-caption">
  <p class="demo-card__merchant">Acme Studio</p>
  <p class="demo-card__plan">Pro plan</p>
  <p class="demo-card__amount np-money np-money--hero">{money(price, USD)}</p>
  <p class="demo-card__label">Pay with</p>
  <div class="demo-card__field">
    <span>USDC · Base</span>
    <svg class="np-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7 9.5h10l-5 6z"></path></svg>
    <span class="demo-card__field-icon"><Icon name="search" /></span>
  </div>
  <dl class="np-kv np-kv--inline">
    <div class="np-kv__row">
      <dt class="np-kv__label">Payment fees</dt>
      <dd class="np-kv__value">{money(fee, USD)}</dd>
    </div>
  </dl>
  <p class="demo-card__pay">Pay {money(payUsdc, USDC)}</p>
  <hr class="np-divider" />
  <div class="np-callout np-callout--success np-callout--icon">
    <Icon name="check" class="np-callout__icon" />
    <div class="np-callout__content">
      <p class="np-callout__title">Merchant receives {money(receiveUsdc, USDC)}</p>
      <p class="np-callout__body">Straight to their chosen destination</p>
    </div>
  </div>
  <figcaption id="demo-card-caption" class="demo-card__caption">Illustrative checkout · fees vary by payment</figcaption>
</figure>
