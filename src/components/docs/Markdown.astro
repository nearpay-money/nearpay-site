---
/**
 * Renders the short Markdown the spec uses in descriptions (`code`, **bold**, links are not used) as
 * escaped HTML: only inline code is converted, everything else is text.
 */
interface Props {
  text?: string;
}
const { text = "" } = Astro.props;
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const html = esc(text).replace(/`([^`]+)`/g, "<code>$1</code>");
---
<Fragment set:html={html} />
