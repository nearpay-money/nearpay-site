---
/**
 * Inline SVG icons drawn from the @nearpay-internal/ui icon set (24 × 24, 1.75 px stroke, currentColor).
 * The kit ships its icons as React components only; the site renders them without a runtime, so the
 * paths are mirrored here (kit gap: a framework-neutral SVG export). Decorative unless `title` is set.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  title?: string;
  class?: string;
}
const PATHS = {
  "arrow-right": ["M5 12h14M13 6l6 6-6 6"],
  "arrow-left": ["M19 12H5M11 6l-6 6 6 6"],
  check: ["M4.5 12.5l5 5 10-11"],
  search: ["M20 20l-4.25-4.25", "circle:11:11:6.5"],
  "chevron-down": ["M7 10l5 5 5-5"],
  "chevron-right": ["M10 7l5 5-5 5"],
  copy: ["rect:9:9:11:11:2", "M15 9V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7a2 2 0 002 2h3"],
  external: ["M8 16L16.5 7.5M9.5 7.5h7v7"],
  menu: ["M4 7h16M4 12h16M4 17h16"],
  close: ["M6 6l12 12M18 6L6 18"],
  info: ["circle:12:12:8.5", "M12 11v5M12 8h.01"],
  warning: [
    "M10.3 4.6L3.1 17.2A2 2 0 004.8 20h14.4a2 2 0 001.7-2.8L13.7 4.6a2 2 0 00-3.4 0z",
    "M12 9.5v4M12 16.75h.01",
  ],
  "shield-check": ["M12 3l7 3v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6l7-3z", "M8.75 12.25l2.25 2.25 4.25-4.5"],
  wallet: ["M4 7.5A2.5 2.5 0 016.5 5H18v3", "rect:4:8:16:11:2", "M16 13.5h1.5"],
  card: ["rect:3.5:5.5:17:13:1.5", "M3.5 10h17M7 14.5h4"],
  clock: ["circle:12:12:8.5", "M12 7.5V12l3 2"],
  bell: ["M6.5 16.5V11a5.5 5.5 0 0111 0v5.5l1.5 1.5H5l1.5-1.5z", "M10 20.5h4"],
} as const;
const { name, size = 20, title, class: className } = Astro.props;
const shapes = PATHS[name].map((d) => {
  const [kind, ...n] = d.split(":");
  if (kind === "circle") return { kind, cx: n[0], cy: n[1], r: n[2] };
  if (kind === "rect") return { kind, x: n[0], y: n[1], w: n[2], h: n[3], rx: n[4] };
  return { kind: "path", d };
});
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  class:list={["np-icon", className]}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
>
  {
    shapes.map((s) =>
      s.kind === "circle" ? (
        <circle cx={s.cx} cy={s.cy} r={s.r} />
      ) : s.kind === "rect" ? (
        <rect x={s.x} y={s.y} width={s.w} height={s.h} rx={s.rx} />
      ) : (
        <path d={s.d} />
      ),
    )
  }
</svg>
