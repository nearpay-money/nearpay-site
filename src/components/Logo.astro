---
/**
 * NearPay logo, design v2 "A. Convergence": the kit's brand mark (`markSvg`, exact geometry, presentation
 * attributes only — CSP-safe) + the "NearPay" wordmark set in Instrument Sans 650.
 * `light` = teal routes / violet dot (white surfaces); `dark` = mint routes / light-violet dot (navy).
 */
import { markSvg } from "@nearpay-internal/ui/brand";

interface Props {
  href: string;
  label?: string;
  variant?: "light" | "dark";
  /** Mark size in px (wordmark scales with it: 30 → 21 px, the artboard header). */
  size?: number;
}
const { href, label = "NearPay home", variant = "light", size = 30 } = Astro.props;
const mark = markSvg({ variant, size, xmlns: false, className: "site-logo__mark" });
---
<a class:list={["site-logo", `site-logo--${variant}`, { "site-logo--sm": size < 30 }]} href={href} aria-label={label}>
  <Fragment set:html={mark} />
  <span class="site-logo__word" aria-hidden="true">NearPay</span>
</a>
